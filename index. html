<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>GramSolve | Rural Problems, Real Solutions</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <nav class="navbar">
            <div class="logo">🌱 Gram<span>Solve</span></div>

            <div class="nav-links">
                <a href="#home">Home</a>
                <a href="#problems">Problems</a>
                <a href="#solutions">Solutions</a>
                <a href="#report">Report</a>
            </div>

            <button class="nav-btn" onclick="scrollToReport()">
                Report a Problem
            </button>
        </nav>
    </header>


    <!-- HERO SECTION -->
    <section class="hero" id="home">

        <div class="hero-content">

            <p class="tagline">🌾 VOICES OF RURAL INDIA</p>

            <h1>
                Small Problems.
                <span>Big Impact.</span>
            </h1>

            <p class="hero-text">
                A simple platform where rural communities can report
                everyday problems, understand their impact and discover
                possible solutions.
            </p>

            <div class="hero-buttons">
                <button class="primary-btn" onclick="scrollToReport()">
                    Report a Problem →
                </button>

                <button class="secondary-btn" onclick="scrollToProblems()">
                    Explore Problems
                </button>
            </div>

        </div>

        <div class="hero-card">

            <div class="floating-icon">🌾</div>

            <h3>What's happening in your village?</h3>

            <p>
                Food • Farming • Healthcare • Education • Waste • Transport
            </p>

            <div class="mini-stat">
                <strong id="problemCount">0</strong>
                <span>Problems reported</span>
            </div>

        </div>

    </section>


    <!-- CATEGORIES -->
    <section class="categories" id="problems">

        <div class="section-heading">
            <p class="small-title">EXPLORE</p>

            <h2>Problems That Matter</h2>

            <p>
                Every problem deserves to be heard.
            </p>
        </div>


        <div class="category-grid">

            <div class="category-card" onclick="showCategory('Farming')">
                <div class="category-icon">🌾</div>
                <h3>Farming</h3>
                <p>Crop, irrigation and farming challenges.</p>
            </div>

            <div class="category-card" onclick="showCategory('Waste')">
                <div class="category-icon">♻️</div>
                <h3>Waste</h3>
                <p>Garbage collection and sanitation issues.</p>
            </div>

            <div class="category-card" onclick="showCategory('Healthcare')">
                <div class="category-icon">🏥</div>
                <h3>Healthcare</h3>
                <p>Access to doctors, medicines and hospitals.</p>
            </div>

            <div class="category-card" onclick="showCategory('Education')">
                <div class="category-icon">📚</div>
                <h3>Education</h3>
                <p>Schools, teachers and learning resources.</p>
            </div>

            <div class="category-card" onclick="showCategory('Transport')">
                <div class="category-icon">🚌</div>
                <h3>Transport</h3>
                <p>Roads, buses and connectivity problems.</p>
            </div>

            <div class="category-card" onclick="showCategory('Water')">
                <div class="category-icon">💧</div>
                <h3>Water</h3>
                <p>Drinking water and irrigation problems.</p>
            </div>

        </div>

    </section>


    <!-- IMPACT SECTION -->
    <section class="impact">

        <div class="impact-text">

            <p class="small-title">WHY IT MATTERS</p>

            <h2>
                A problem becomes
                <span>visible</span>
                when someone speaks about it.
            </h2>

            <p>
                GramSolve connects local problems with community
                awareness and possible solutions.
            </p>

        </div>


        <div class="impact-stats">

            <div>
                <strong>01</strong>
                <span>Report</span>
            </div>

            <div>
                <strong>02</strong>
                <span>Understand</span>
            </div>

            <div>
                <strong>03</strong>
                <span>Find Solutions</span>
            </div>

        </div>

    </section>


    <!-- SOLUTIONS -->
    <section class="solutions" id="solutions">

        <div class="section-heading">

            <p class="small-title">FROM PROBLEM TO ACTION</p>

            <h2>How GramSolve Works</h2>

        </div>


        <div class="steps">

            <div class="step">
                <span>01</span>
                <div>
                    <h3>Speak Up</h3>
                    <p>Report an issue from your community.</p>
                </div>
            </div>

            <div class="step">
                <span>02</span>
                <div>
                    <h3>Understand</h3>
                    <p>See how the problem affects people.</p>
                </div>
            </div>

            <div class="step">
                <span>03</span>
                <div>
                    <h3>Explore</h3>
                    <p>Discover practical solution ideas.</p>
                </div>
            </div>

        </div>

    </section>


    <!-- REPORT FORM -->
    <section class="report-section" id="report">

        <div class="form-container">

            <div class="form-info">

                <p class="small-title">YOUR VOICE MATTERS</p>

                <h2>
                    Tell us about a problem
                    in your community.
                </h2>

                <p>
                    Your report can help bring attention to problems
                    that are often overlooked.
                </p>

                <div class="form-tip">
                    💡 <strong>Tip:</strong>
                    Be specific about the problem and its location.
                </div>

            </div>


            <form id="problemForm">

                <label>Your Name</label>
                <input
                    type="text"
                    id="name"
                    placeholder="Enter your name"
                    required
                >

                <label>Village / Location</label>
                <input
                    type="text"
                    id="location"
                    placeholder="Enter village or location"
                    required
                >

                <label>Problem Category</label>

                <select id="category" required>
                    <option value="">Select category</option>
                    <option>Farming</option>
                    <option>Waste</option>
                    <option>Healthcare</option>
                    <option>Education</option>
                    <option>Transport</option>
                    <option>Water</option>
                    <option>Other</option>
                </select>


                <label>Describe the Problem</label>

                <textarea
                    id="description"
                    rows="5"
                    placeholder="Describe the problem..."
                    required
                ></textarea>


                <button class="submit-btn" type="submit">
                    Submit Problem 🚀
                </button>

            </form>

        </div>

    </section>


    <!-- FOOTER -->
    <footer>

        <div class="footer-logo">
            🌱 GramSolve
        </div>

        <p>
            Turning rural problems into possibilities.
        </p>

        <p class="copyright">
            © 2026 GramSolve
        </p>

    </footer>


    <script src="script.js"></script>

</body>
</html>
