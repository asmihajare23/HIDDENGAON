<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Maza Gaon | Smart Village Portal</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: #f6faf4;
            color: #263528;
        }

        /* ================= NAVBAR ================= */

        nav {
            height: 72px;
            width: 100%;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 6%;

            background: white;

            position: sticky;
            top: 0;

            z-index: 1000;

            box-shadow: 0 3px 15px rgba(0,0,0,.08);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;

            font-size: 24px;
            font-weight: bold;

            color: #28752e;
        }

        .logo span {
            font-size: 32px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 25px;
        }

        .nav-links a {
            text-decoration: none;
            color: #465246;
            font-size: 14px;
            font-weight: 600;
        }

        .nav-links a:hover {
            color: #2e7d32;
        }

        .login-btn {
            background: #2e7d32;
            color: white !important;

            padding: 10px 18px;

            border-radius: 20px;
        }

        .login-btn:hover {
            background: #1b5e20;
        }


        /* ================= HERO ================= */

        .hero {
            min-height: 650px;

            display: flex;
            align-items: center;

            padding: 70px 8%;

            position: relative;
            overflow: hidden;

            background:
                linear-gradient(
                    135deg,
                    #dff5d8,
                    #f7fff4
                );
        }

        .hero-content {
            width: 55%;
            z-index: 2;
        }

        .tag {
            display: inline-block;

            padding: 8px 15px;

            background: #e1f3df;

            color: #28752e;

            border-radius: 20px;

            font-size: 13px;
            font-weight: bold;

            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: 60px;
            line-height: 1.1;

            color: #215c27;

            margin-bottom: 18px;
        }

        .hero h1 span {
            color: #e38b25;
        }

        .hero p {
            max-width: 600px;

            font-size: 18px;
            line-height: 1.7;

            color: #5d695d;

            margin-bottom: 30px;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
        }

        .primary-btn,
        .secondary-btn {
            padding: 14px 23px;

            border-radius: 12px;

            text-decoration: none;

            font-weight: bold;

            transition: .3s;
        }

        .primary-btn {
            background: #2e7d32;
            color: white;
        }

        .secondary-btn {
            background: white;
            color: #2e7d32;

            border: 1px solid #c9dfc8;
        }

        .primary-btn:hover,
        .secondary-btn:hover {
            transform: translateY(-3px);
        }


        /* HERO ILLUSTRATION */

        .village {
            position: absolute;

            right: 5%;
            bottom: 0;

            width: 42%;
            height: 80%;

            display: flex;
            align-items: flex-end;
            justify-content: center;
        }

        .sun {
            position: absolute;

            width: 110px;
            height: 110px;

            background: #ffd54f;

            border-radius: 50%;

            top: 5%;
            right: 20%;

            box-shadow: 0 0 50px #ffd54f;
        }

        .mountain {
            position: absolute;

            bottom: 0;

            width: 100%;
            height: 230px;

            background: #78a75d;

            clip-path: polygon(
                0 70%,
                25% 25%,
                42% 60%,
                65% 15%,
                100% 70%,
                100% 100%,
                0 100%
            );
        }

        .house {
            position: absolute;

            bottom: 70px;

            width: 180px;
            height: 130px;

            background: #f2c078;

            border: 3px solid #8c5c35;
        }

        .roof {
            position: absolute;

            top: -80px;
            left: -25px;

            width: 230px;
            height: 100px;

            background: #9b4d32;

            clip-path: polygon(
                50% 0,
                100% 100%,
                0 100%
            );
        }

        .door {
            position: absolute;

            bottom: 0;
            left: 65px;

            width: 45px;
            height: 75px;

            background: #75472d;
        }

        .tree {
            position: absolute;

            bottom: 60px;
            left: 8%;

            font-size: 90px;
        }


        /* ================= SECTION ================= */

        .section {
            padding: 80px 8%;
        }

        .section-title {
            text-align: center;

            margin-bottom: 45px;
        }

        .section-title h2 {
            font-size: 36px;

            color: #285f2d;
        }

        .section-title p {
            margin-top: 10px;

            color: #6d776d;
        }


        /* ================= SERVICES ================= */

        .services {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 20px;
        }

        .service-card {
            background: white;

            padding: 30px 22px;

            border-radius: 20px;

            text-align: center;

            box-shadow:
                0 8px 25px rgba(0,0,0,.07);

            transition: .3s;

            border: 1px solid #edf2eb;
        }

        .service-card:hover {
            transform: translateY(-8px);

            box-shadow:
                0 15px 30px rgba(0,0,0,.11);
        }

        .service-icon {
            width: 70px;
            height: 70px;

            margin: auto;
            margin-bottom: 18px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 20px;

            background: #e8f5e5;

            font-size: 35px;
        }

        .service-card h3 {
            margin-bottom: 10px;

            color: #315c35;
        }

        .service-card p {
            font-size: 13px;

            color: #727a72;

            line-height: 1.6;
        }


        /* ================= ABOUT ================= */

        .about {
            background: #edf7ea;

            display: flex;
            align-items: center;

            gap: 60px;
        }

        .about-text {
            flex: 1;
        }

        .about-text h2 {
            font-size: 38px;

            color: #285f2d;

            margin-bottom: 18px;
        }

        .about-text p {
            line-height: 1.8;

            color: #5f695f;

            margin-bottom: 15px;
        }

        .about-box {
            flex: 1;

            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 15px;
        }

        .stat {
            background: white;

            padding: 30px;

            border-radius: 18px;

            text-align: center;
        }

        .stat strong {
            display: block;

            font-size: 30px;

            color: #2e7d32;

            margin-bottom: 5px;
        }

        .stat span {
            color: #697269;

            font-size: 13px;
        }


        /* ================= COMPLAINT ================= */

        .complaint {
            background:
                linear-gradient(
                    135deg,
                    #276c2d,
                    #4d9c4f
                );

            color: white;

            text-align: center;

            padding: 70px 20px;
        }

        .complaint h2 {
            font-size: 35px;

            margin-bottom: 12px;
        }

        .complaint p {
            opacity: .9;

            margin-bottom: 25px;
        }

        .complaint-btn {
            display: inline-block;

            padding: 13px 25px;

            background: white;

            color: #28752e;

            border-radius: 12px;

            text-decoration: none;

            font-weight: bold;
        }


        /* ================= ANNOUNCEMENTS ================= */

        .announcements {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 20px;
        }

        .announcement {
            background: white;

            padding: 25px;

            border-radius: 18px;

            border-left: 5px solid #4caf50;

            box-shadow:
                0 5px 18px rgba(0,0,0,.06);
        }

        .announcement small {
            color: #7b857b;
        }

        .announcement h3 {
            margin: 10px 0;

            color: #315c35;
        }

        .announcement p {
            font-size: 13px;

            color: #697269;

            line-height: 1.6;
        }


        /* ================= FOOTER ================= */

        footer {
            background: #183d1c;

            color: white;

            padding: 45px 8%;

            display: flex;

            justify-content: space-between;

            gap: 30px;
        }

        footer h3 {
            margin-bottom: 12px;
        }

        footer p {
            color: #b8c7b9;

            font-size: 13px;

            line-height: 1.6;
        }

        .footer-links {
            display: flex;
            gap: 20px;
        }

        .footer-links a {
            color: #d5e4d6;

            text-decoration: none;

            font-size: 13px;
        }


        /* ================= LANGUAGE ================= */

        .language {
            position: fixed;

            bottom: 20px;
            right: 20px;

            z-index: 2000;

            background: white;

            padding: 7px;

            border-radius: 30px;

            box-shadow:
                0 5px 20px rgba(0,0,0,.15);
        }

        .language button {
            border: none;

            background: transparent;

            padding: 8px 11px;

            border-radius: 20px;

            cursor: pointer;

            font-size: 11px;
        }

        .language button.active {
            background: #2e7d32;

            color: white;
        }


        /* ================= RESPONSIVE ================= */

        @media(max-width:900px) {

            .nav-links a:not(.login-btn) {
                display: none;
            }

            .hero {
                min-height: 700px;
            }

            .hero-content {
                width: 100%;

                text-align: center;
            }

            .hero p {
                margin-left: auto;
                margin-right: auto;
            }

            .hero-buttons {
                justify-content: center;
            }

            .village {
                opacity: .25;

                width: 100%;

                right: 0;
            }

            .services {
                grid-template-columns:
                    repeat(2, 1fr);
            }

            .about {
                flex-direction: column;
            }

            .announcements {
                grid-template-columns: 1fr;
            }

        }

        @media(max-width:550px) {

            nav {
                padding: 0 20px;
            }

            .logo {
                font-size: 20px;
            }

            .hero {
                padding: 50px 25px;
            }

            .hero h1 {
                font-size: 42px;
            }

            .section {
                padding: 60px 25px;
            }

            .services {
                grid-template-columns: 1fr;
            }

            .about-box {
                grid-template-columns: 1fr;
            }

            footer {
                flex-direction: column;
            }

        }

    </style>
</head>


